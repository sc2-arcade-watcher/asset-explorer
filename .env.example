# Copy to .env and adjust as needed. .env is gitignored.

# Host port for the explorer
HTTP_PORT=8080

# Cache-Control header for static assets.
# Development: no-store
# Production:  public, max-age=3600
CACHE_CONTROL=public, max-age=3600

# imageproxy upstream (internal Docker service name)
IMAGEPROXY_ADDR=imageproxy:8222

# Allowed remote hosts for the image proxy (comma-separated)
IMAGEPROXY_ALLOW_HOSTS=star-assets.github.io,dist.sc2arcade.com
