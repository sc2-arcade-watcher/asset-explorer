:80 {
	root * /srv

	# Proxy thumbnail requests to imageproxy for on-the-fly resizing
	# URL pattern: /thumbs/{options}/{remote_url}
	handle_path /thumbs/* {
		reverse_proxy imageproxy:8222
	}

	file_server

	# Enable gzip/zstd compression
	encode zstd gzip

	# Cache static assets aggressively
	@static {
		path *.js *.css *.html *.png *.jpg *.svg *.woff *.woff2 *.ttf *.glb *.ini
	}
	header @static Cache-Control "public, max-age=3600"

	handle_errors {
		@404 expression {http.error.status_code} == 404
		handle @404 {
			rewrite * /404.html
			file_server
		}
	}
}
