# Reusable snippets
# ─────────────────────────────────────────────────────────────────────────────

(thumbs) {
	handle_path /thumbs/* {
		reverse_proxy {$IMAGEPROXY_ADDR:imageproxy:8222}
	}
}

(static_headers) {
	@static path *.js *.css *.html *.png *.jpg *.svg *.woff *.woff2 *.ttf *.glb *.ini
	header @static Cache-Control "{$CACHE_CONTROL:public, max-age=3600}"
}

(error_pages) {
	handle_errors {
		@404 expression {http.error.status_code} == 404
		handle @404 {
			rewrite * /404.html
			file_server
		}
	}
}

# Site
# ─────────────────────────────────────────────────────────────────────────────

:80 {
	root * /srv

	import thumbs
	file_server
	encode zstd gzip
	import static_headers
	import error_pages
}
