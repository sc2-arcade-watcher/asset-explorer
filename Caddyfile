# Reusable snippets
# ─────────────────────────────────────────────────────────────────────────────

(thumbs) {
	handle_path /thumbs/* {
		reverse_proxy {$IMAGEPROXY_ADDR:imageproxy:8222}
	}
}

(static_headers) {
	@static path *.js *.css *.png *.jpg *.svg *.woff *.woff2 *.ttf *.glb *.ini
	header @static Cache-Control "{$CACHE_CONTROL:public, max-age=3600}"
	@html path *.html /
	header @html Cache-Control "{$CACHE_CONTROL_HTML:public, max-age=60, s-maxage=300, must-revalidate}"
}

(error_pages) {
	handle_errors {
		@404 expression {http.error.status_code} == 404
		handle @404 {
			rewrite * /404.html
			templates {
				mime text/html
			}
			file_server
		}
	}
}

# Site
# ─────────────────────────────────────────────────────────────────────────────

:80 {
	root * /srv

	import thumbs

	# Render Go templates inside HTML files only — JS/INI/CSS may legitimately
	# contain `{{ }}` (template literals etc.) and must be served verbatim.
	templates {
		mime text/html
	}

	file_server
	encode zstd gzip
	import static_headers
	import error_pages
}
